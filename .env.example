# OD3 Academic API (subject/course/teacher mapping import) — read only by
# api/academic-subject-course-mapping.js (a serverless function), never by
# client code, so these must NOT have a VITE_ prefix or they'd ship in the
# browser bundle.
ACADEMIC_API_BASE_URL=https://academic-api.odpay.in
ACADEMIC_API_TOKEN=
ACADEMIC_SESSION=2026-27

# Public — just pre-fills the Entity ID field on the Setup page; the field
# is editable there so one deployment can import different entities/schools.
# Safe to expose (it's an identifier, not a credential), so this one keeps
# the VITE_ prefix.
VITE_ACADEMIC_ENTITY_ID=
